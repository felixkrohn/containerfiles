# Containerfile for opencode with buildah/podman capabilities
# Based on upstream buildah container pattern, extended with opencode and additional tooling

FROM registry.fedoraproject.org/fedora:latest

ARG SOURCE_DATE_EPOCH
ARG FLAVOR=stable

# Configure dnf for forgiving builds on emulated hosts
RUN echo -e "\n\n# Added during image build" >> /etc/dnf/dnf.conf && \
    echo -e "minrate=100\ntimeout=60\n" >> /etc/dnf/dnf.conf

# Install base dependencies: buildah/podman for container orchestration + OCI runtime (crun)
ARG INSTALL_RPMS="buildah fuse-overlayfs cpp git-core podman docker-cli jq vim-minimal ca-certificates dirmngr gnupg2 crun curl nodejs npm python3"

RUN dnf -y makecache && \
    dnf -y update && \
    rpm --setcaps shadow-utils 2>/dev/null && \
    case "${FLAVOR}" in \
      stable) \
        dnf -y install $INSTALL_RPMS --exclude container-selinux \
      ;; \
      testing) \
        dnf -y install $INSTALL_RPMS --exclude container-selinux \
            --enablerepo=updates-testing \
      ;; \
      upstream) \
        dnf -y install 'dnf-command(copr)' --enablerepo=updates-testing && \
        dnf -y copr enable rhcontainerbot/podman-next && \
        dnf -y install $INSTALL_RPMS \
            --exclude container-selinux \
            --enablerepo=updates-testing  \
      ;; \
      *) \
        printf "\\nFLAVOR argument must be set and valid, currently: '${FLAVOR}'\\n\\n" 1>&2 && \
        exit 1 \
      ;; \
    esac && \
    dnf -y clean all && \
    rm -fv /etc/machine-id /var/lib/systemd/random-seed /var/lib/dnf/repos/*/countme && \
    if test -n "$SOURCE_DATE_EPOCH" ; then \
        sqlite3 /usr/lib/sysimage/libdnf5/transaction_history.sqlite "UPDATE trans SET dt_begin=$SOURCE_DATE_EPOCH, dt_end=$SOURCE_DATE_EPOCH; PRAGMA journal_mode=DELETE; PRAGMA journal_mode=WAL" 2>/dev/null || true ; \
    fi && \
    rm -rf /var/cache/*/* /var/log/dnf* /var/log/hawkey.log /var/log/yum.*

RUN npm install -g pnpm

# Setup container configuration files (similar to buildah pattern)
ADD ./containers.conf /etc/containers/

RUN printf '/run/secrets/etc-pki-entitlement:/run/secrets/etc-pki-entitlement\n/run/secrets/rhsm:/run/secrets/rhsm\n' > /etc/containers/mounts.conf

# Configure storage for rootless operation with fuse-overlayfs
RUN sed -e 's|^#mount_program|mount_program|g' \
        -e '/additionalimage.*/a "/var/lib/shared",' \
        -e 's|^mountopt[[:space:]]*=.*$|mountopt = "nodev,fsync=0"|g' \
        /usr/share/containers/storage.conf \
        > /etc/containers/storage.conf && \
    chmod 644 /etc/containers/storage.conf

# Setup shared overlay directories for storage locking
RUN mkdir -p /var/lib/shared/overlay-images \
             /var/lib/shared/overlay-layers \
             /var/lib/shared/vfs-images \
             /var/lib/shared/vfs-layers && \
    touch /var/lib/shared/overlay-images/images.lock && \
    touch /var/lib/shared/overlay-layers/layers.lock && \
    touch /var/lib/shared/vfs-images/images.lock && \
    touch /var/lib/shared/vfs-layers/layers.lock

# Create opencode with proper UID/GID ranges for rootless containers
RUN useradd -m -u 1000 -G root opencode && \
    echo -e "root:1:65535\nopencode:1:999\nopencode:1001:64535" > /etc/subuid && \
    echo -e "root:1:65535\nopencode:1:999\nopencode:1001:64535" > /etc/subgid

# run: chmod -R g+rw ~/.local/share/opencode/  ~/.config/opencode  ~/.local/state/opencode

USER opencode
ENV PATH="/home/opencode/.local/bin:${PATH}"
WORKDIR /home/opencode

#install yq
RUN mkdir -p /home/opencode/.local/bin && curl -L https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64 -o /home/opencode/.local/bin/yq && chmod +x /home/opencode/.local/bin/yq

# Install opencode from latest GitHub release
RUN mkdir -p /home/opencode/.config/opencode/ && \
    export DOWNLOAD_URL=$(curl -sL https://api.github.com/repos/anomalyco/opencode/releases/latest | jq -r '.assets[] | select(.name == "opencode-linux-x64.tar.gz") | .browser_download_url') && \
    curl -L "${DOWNLOAD_URL}" -o /tmp/opencode.tar.gz && \
    mkdir -p ~/.opencode && \
    tar -xzf /tmp/opencode.tar.gz -C ~/.opencode && \
    mkdir -p ~/.local/bin && \
    ln -s ~/.opencode/opencode ~/.local/bin/opencode && \
    rm -f /tmp/opencode.tar.gz
COPY opencode.json /home/opencode/.config/opencode/

# Volumes for container storage and user data
VOLUME /var/lib/containers
#VOLUME /home/opencode/.local/share/containers

ENV BUILDAH_ISOLATION=chroot
env TERM xterm-256color

ENTRYPOINT ["opencode"]
